@page "/"

<PageTitle>Mateusz Ciszek — C# & Unity Developer</PageTitle>
<ContentView Context="content">
    @{ var workbenchProject = content.Projects.First(p => p.Slug == "power-washer-hero"); }
    <section class="hero">
        <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> C# & UNITY DEVELOPER</p><h1>I build games.<br />And what makes<br />them <em>work.</em></h1><p class="hero-description">Hey, I’m Mateusz. I turn ideas into playable worlds,<br class="desktop-break" /> thoughtful tools, and dependable systems.</p><div class="hero-actions"><a class="button primary" href="games">Explore my work <span>↗</span></a><a class="text-link" href="about">A little about me <span>→</span></a></div><div class="hero-footnote"><span>GAMEPLAY</span><span>TOOLS & SYSTEMS</span><span>MOBILE</span></div></div>
        <div class="hero-feature">
            <div class="feature-topline"><span><span class="status-dot"></span> ON MY WORKBENCH</span><span>01 / FEATURED</span></div>
            <a class="hero-game-image" href="projects/@workbenchProject.Slug"><img src="@workbenchProject.Image" alt="@workbenchProject.ImageAlt" fetchpriority="high" /><span class="image-label">UNITY / 3D</span></a>
            <div class="feature-bottom"><div><span class="eyebrow">@workbenchProject.Status</span><h2><a href="projects/@workbenchProject.Slug">@workbenchProject.Title <span>↗</span></a></h2></div><span class="feature-index">01</span></div>
            <div class="feature-links"><a href="projects/@workbenchProject.Slug">Explore the project ↗</a></div>
        </div>
    </section>
    <section class="section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>A few things I’ve built<span class="accent">.</span></h2></div><span class="section-note">From the first prototype to the systems underneath.</span></div><div class="project-grid">@foreach (var project in content.Projects.Where(p => p.Featured)) { <ProjectCard Project="project" /> }</div></section>
    <section class="section"><div class="section-heading"><div><p class="eyebrow">02 / EXPLORE</p><h2>Different platforms.<br />Same curiosity<span class="accent">.</span></h2></div></div><div class="category-list">@foreach (var category in PortfolioContent.Categories) { <a href="@category.Path" class="category-row"><span class="category-number">@category.Number</span><h3>@category.Name</h3><span class="category-description">@category.Description</span><span class="category-arrow">↗</span></a> }</div></section>
    <section class="about-banner"><p class="eyebrow">THE PERSON BEHIND THE CODE</p><h2>Good games start with curiosity.<br />Good systems keep them growing.</h2><a class="button secondary" href="about">Meet the developer <span>↗</span></a></section>
</ContentView>
