@page "/projects/{Slug}"
<ContentView Context="content">
    @{ var project = content.Projects.FirstOrDefault(p => p.Slug == Slug); }
    @if (project is null) { <PageTitle>Project not found — Mateusz Ciszek</PageTitle><NotFound /> }
    else
    {
        <PageTitle>@project.Title — Mateusz Ciszek</PageTitle>
        <section class="page-heading detail-heading"><a class="eyebrow breadcrumb" href="@project.Category">← @PortfolioContent.Categories.First(c => c.Path == project.Category).Name.ToUpperInvariant()</a><h1>@project.Title</h1>@if (!string.IsNullOrWhiteSpace(project.Subtitle)) { <p class="project-subtitle">@project.Subtitle</p> }<p>@project.Summary</p><div class="tags">@foreach (var tag in project.Tags) { <span>@tag</span> }</div></section>
        @if (!string.IsNullOrWhiteSpace(project.Image)) { <div class="detail-cover @(project.ImageWidth.HasValue ? "natural-cover" : "")"><img src="@project.Image" alt="@project.ImageAlt" width="@project.ImageWidth" height="@project.ImageHeight" /></div> }
        else { <div class="detail-cover illustrated"><ProjectArt Project="project" /></div> }
        <div class="detail-layout"><aside><div class="detail-meta"><span class="eyebrow">MY ROLE</span><p>@project.Role</p><span class="eyebrow">PROJECT STATUS</span><p>@project.Status</p>@if (!string.IsNullOrWhiteSpace(project.Technologies)) { <span class="eyebrow">TECHNOLOGIES</span><p>@project.Technologies</p> }@if (!string.IsNullOrWhiteSpace(project.FocusAreas)) { <span class="eyebrow">FOCUS AREAS</span><p>@project.FocusAreas</p> }</div>@foreach (var link in project.Links.Where(l => !string.IsNullOrWhiteSpace(l.Url))) { <a class="button secondary" href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label ↗</a> }</aside><article class="project-story"><p class="eyebrow">THE PROJECT</p><h2>Behind the build.</h2>@foreach (var paragraph in project.Overview) { <p>@paragraph</p> }
        @if (project.Videos.Count > 0)
        {
            <h2>@project.VideosHeading</h2>
            <div class="game-videos @(project.Videos.Count == 1 ? "single-video" : "")">@foreach (var video in project.Videos) { <GameplayVideo @key="video.YoutubeId" Video="video" /> }</div>
        }
        @foreach (var section in project.Sections)
        {
            <section class="technical-section">
                <h2 class="system-heading">@section.Title @if (!string.IsNullOrWhiteSpace(section.Badge)) { <span class="tags"><span>@section.Badge</span></span> }</h2>
                @if (!string.IsNullOrWhiteSpace(section.Summary)) { <p class="section-summary">@section.Summary</p> }
                @foreach (var paragraph in section.Paragraphs) { <p>@paragraph</p> }
                @if (section.Image is not null)
                {
                    <figure>
                        <a href="@section.Image.Url" data-image-preview aria-haspopup="dialog" aria-label="@($"Open full-size image: {section.Title}")"><img src="@section.Image.Url" alt="@section.Image.Alt" width="@section.Image.Width" height="@section.Image.Height" loading="lazy" /></a>
                        @if (!string.IsNullOrWhiteSpace(section.Caption)) { <figcaption>@section.Caption</figcaption> }
                    </figure>
                }
                @if (section.Gallery.Count > 0)
                {
                    <div class="screenshot-gallery system-gallery">
                        @foreach (var shot in section.Gallery)
                        {
                            <figure>
                                <a href="@shot.Url" data-image-preview aria-haspopup="dialog" aria-label="@($"Open full-size screenshot: {shot.Alt}")"><img src="@shot.Url" alt="@shot.Alt" width="@shot.Width" height="@shot.Height" loading="lazy" /></a>
                                <figcaption>@shot.Caption</figcaption>
                            </figure>
                        }
                    </div>
                }
                @foreach (var additionalImage in section.AdditionalImages)
                {
                    <figure>
                        <a href="@additionalImage.Url" data-image-preview aria-haspopup="dialog" aria-label="@($"Open full-size image: {additionalImage.Alt}")"><img src="@additionalImage.Url" alt="@additionalImage.Alt" loading="lazy" /></a>
                        <figcaption>@additionalImage.Alt</figcaption>
                    </figure>
                }
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(project.Challenge)) { <h2>The challenge</h2><p>@project.Challenge</p> }
        @if (!string.IsNullOrWhiteSpace(project.Solution)) { <h2>The approach</h2><p>@project.Solution</p> }
        @if (!string.IsNullOrWhiteSpace(project.Lessons)) { <h2>What I learned</h2><p>@project.Lessons</p> }
        @if (project.MiniGames.Count > 0)
        {
            <h2>Mini-games I built.</h2>
            <div class="minigame-list">
            @foreach (var game in project.MiniGames)
            {
                <section class="minigame-entry">
                    <h3>@game.Title</h3>
                    <p>@game.Description</p>
                    @if (game.Videos.Count > 0)
                    {
                        <div class="game-videos @(game.Videos.Count == 1 ? "single-video" : "")">@foreach (var video in game.Videos) { <GameplayVideo @key="video.YoutubeId" Video="video" /> }</div>
                    }
                    @if (game.TechnicalNotes.Length > 0)
                    {
                        <ul>@foreach (var note in game.TechnicalNotes) { <li>@note</li> }</ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(game.VideoUrl))
                    { <a class="button secondary" href="@game.VideoUrl" target="_blank" rel="noopener noreferrer">Watch @game.Title gameplay ↗</a> }
                </section>
            }
            </div>
        }
        @if (project.Screenshots.Count > 0)
        {
            <section class="screenshots-section" aria-labelledby="screenshots-heading">
                <h2 id="screenshots-heading">@project.ScreenshotsHeading</h2>
                <div class="screenshot-gallery @(project.Screenshots.Count == 1 ? "single-image" : "")">
                @foreach (var shot in project.Screenshots)
                {
                    <figure><a href="@shot.Url" data-image-preview aria-haspopup="dialog" aria-label="@($"Open full-size screenshot: {shot.Alt}")"><img src="@shot.Url" alt="@shot.Alt" loading="lazy" /></a>@if (project.ShowScreenshotCaptions) { <figcaption>@shot.Alt</figcaption> }</figure>
                }
                </div>
            </section>
        }
        @foreach (var group in project.ScreenshotGroups)
        {
            <section class="screenshots-section">
                <h2>@group.Title</h2>
                <div class="screenshot-gallery app-screens">
                    @foreach (var shot in group.Images)
                    {
                        <figure>
                            <a class="screen-crop" href="@shot.Url" data-image-preview aria-haspopup="dialog" aria-label="@($"Open full-size screenshot: {shot.Alt}")"><img src="@shot.Url" alt="@shot.Alt" style="@shot.CropStyle" loading="lazy" /></a>
                            <figcaption>@shot.Alt</figcaption>
                        </figure>
                    }
                </div>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(project.VideoUrl)) { <a class="button secondary" href="@project.VideoUrl" target="_blank" rel="noopener noreferrer">Watch gameplay ↗</a> }
        @if (project.ShowDevelopmentNotice) { <div class="project-update"><span class="status-dot"></span> Detailed development notes and additional media coming soon.</div> }</article></div>
    }
</ContentView>
@code { [Parameter] public string Slug { get; set; } = ""; }
