<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* Routes sharing a component can have identical parameters; key by path to refresh their content. *@
        <RouteView @key="Navigation.Uri.Split('?', '#')[0]" RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
@inject NavigationManager Navigation
